# ==============================================================================
# VaniShield AI — Environment Configuration
# ==============================================================================

# Sarvam AI API Key for Indic Speech-to-Text (STT) Saaras model
# (Hindi, Bengali, Indian English, Hinglish, Marathi, etc.)
# Obtain your key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# ElevenLabs API Key for Neural Cloned Voice Text-to-Speech (TTS)
# (Used to synthesize cloned deepfakes, test attack vectors, and calibrate models)
# Obtain your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Optional Hugging Face Token for high rate limits and authenticated downloads
# Obtain your token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: Port for local Jev-Omni 12B Llama Server (Default: http://127.0.0.1:9931)
VANISHIELD_JEV_URL=http://127.0.0.1:9931

# Shared control PIN for administrative actions that persist state:
# adding to or removing from the scammer blacklist. Sent as the
# X-VaniShield-Pin header. Leave unset to disable those endpoints entirely;
# there is deliberately no default, because a well-known default PIN on a
# persisted blacklist is worse than not having the feature.
VANISHIELD_CONTROL_PIN=

# Seconds between inference passes on one live call (default 0.5).
# Set to 0 to score every incoming audio packet.
VANISHIELD_MIN_EVAL_INTERVAL=0.5
