# ==============================================================================
# Project VaniShield AI — Ultra-Lightweight Edge / Cloud Gateway Dockerfile
# Target: Low-RAM Cloud Instances (<512MB RAM), Voroa Starter, Edge Nodes
# Footprint: ~120MB RAM, zero heavy PyTorch/CUDA wheels, fast <45s build
# ==============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000

# Install audio runtime library & curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install lightweight dependencies
COPY requirements-edge.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-edge.txt

# Copy application source
COPY . /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD sh -c "curl -f http://localhost:${PORT:-8000}/health || exit 1"

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
